---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form id="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-6" data-testid="game-filters">
            <div class="grid gap-6 lg:grid-cols-[2fr_1fr_auto] lg:items-end">
              <fieldset>
                <legend class="mb-3 font-medium text-slate-100">Filter by category</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition focus-within:ring-2 focus-within:ring-blue-400">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 accent-blue-500"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block font-medium text-slate-100">Filter by publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-400"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>

              <div class="flex gap-3">
                <button type="submit" data-testid="apply-filters" class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400">
                  Apply
                </button>
                <button type="reset" data-testid="clear-filters" class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-400">
                  Clear
                </button>
              </div>
            </div>
          </form>

          <p id="filter-status" class="mb-4 text-sm text-slate-400" data-testid="filter-status" role="status" aria-live="polite"></p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match these filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (form && grid && emptyState && status) {
    const parseState = () => {
      const params = new URLSearchParams(window.location.search);
      const categories = [...new Set(params.getAll('category').filter((value) => /^\d+$/.test(value)))].sort((a, b) => Number(a) - Number(b));
      const publisher = params.get('publisher');
      return { categories, publisher: publisher && /^\d+$/.test(publisher) ? publisher : '' };
    };

    const updateUrl = (replace = false) => {
      const params = new URLSearchParams();
      Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
        .map((input) => input.value)
        .sort((a, b) => Number(a) - Number(b))
        .forEach((value) => params.append('category', value));
      const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value;
      if (publisher) params.set('publisher', publisher);
      const query = params.toString();
      const url = query ? `${window.location.pathname}?${query}` : window.location.pathname;
      window.history[replace ? 'replaceState' : 'pushState']({}, '', url);
    };

    const render = () => {
      const { categories, publisher } = parseState();
      form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
        input.checked = categories.includes(input.value);
      });
      const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
      if (publisherInput) publisherInput.value = publisher;

      let visible = 0;
      cards.forEach((card) => {
        const categoryId = card.dataset.categoryId;
        const matchesCategory = categories.length === 0 || (categoryId !== undefined && categories.includes(categoryId));
        const matchesPublisher = !publisher || card.dataset.publisherId === publisher;
        const matches = matchesCategory && matchesPublisher;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      grid.hidden = visible === 0;
      emptyState.classList.toggle('hidden', visible !== 0);
      status.textContent = `${visible} ${visible === 1 ? 'game' : 'games'} shown`;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      updateUrl();
      render();
    });
    form.addEventListener('reset', () => {
      window.setTimeout(() => {
        updateUrl();
        render();
      });
    });
    window.addEventListener('popstate', render);
    render();
  }
</script>
